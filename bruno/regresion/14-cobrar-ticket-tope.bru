meta {
  name: Cobrar exactamente seis horas con tope
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/tickets/{{topeId}}/salida
  body: json
  auth: none
}

body:json {
  {
    "salida": "2026-10-22T14:00:00"
  }
}

assert {
  res.status: eq 200
  res.body.minutos: eq 360
  res.body.monto: eq 60
}
