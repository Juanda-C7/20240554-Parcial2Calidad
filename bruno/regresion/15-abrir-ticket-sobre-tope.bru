meta {
  name: Abrir ticket para probar cobro sobre el tope
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/tickets
  body: json
  auth: none
}

body:json {
  {
    "placa": "P321JKL",
    "entrada": "2026-10-22T08:00:00"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("sobreTopeId", res.body.id);
}
