meta {
  name: Cobrar más de seis horas sin superar el tope
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/tickets/{{sobreTopeId}}/salida
  body: json
  auth: none
}

body:json {
  {
    "salida": "2026-10-22T15:00:00"
  }
}

assert {
  res.status: eq 200
  res.body.minutos: eq 420
  res.body.monto: eq 60
}
